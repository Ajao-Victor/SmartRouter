# SmartRouter web — public config only (every key is NEXT_PUBLIC_* and ships in the browser bundle).
# Never put provider keys, the hot wallet, the operator key or a dRPC key URL here.
#
# The four values the PDF requires on Vercel ("Vercel environment variables"):
#   NEXT_PUBLIC_API_URL        https://api.<domain> (production) / https://api-staging.<domain> (staging)
#   NEXT_PUBLIC_TEMPO_NETWORK  tempo (mainnet) | moderato (testnet)
#   NEXT_PUBLIC_CHAIN_ID       4217 (tempo) | 42431 (moderato)
#   NEXT_PUBLIC_RPC_URL        https://rpc.tempo.xyz | https://rpc.moderato.tempo.xyz  (public RPC only)
#
# Testnet (staging) values below. Mainnet: the mainnet Heroku app / https://api.<domain>, tempo, 4217, https://rpc.tempo.xyz.

# --- required -------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://smartrouter-testnet-8f580f845259.herokuapp.com
NEXT_PUBLIC_TEMPO_NETWORK=moderato
NEXT_PUBLIC_CHAIN_ID=42431
NEXT_PUBLIC_RPC_URL=https://rpc.moderato.tempo.xyz

# --- optional -------------------------------------------------------------------------------
# Object-storage host for generated images and songs (hostname only, used for next/image + CSP)
NEXT_PUBLIC_OBJECT_STORAGE_HOST=

# Sentry (browser). Empty = monitoring off.
NEXT_PUBLIC_SENTRY_DSN=

# Feature flags (PDF cut order: Compare first, then music). 1 = on.
NEXT_PUBLIC_FLAG_COMPARE=1
NEXT_PUBLIC_FLAG_MUSIC=1

# Run fully offline against the MSW mock API (dev/tests only — never set on Vercel).
NEXT_PUBLIC_MOCK=0
