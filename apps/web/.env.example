# SmartRouter web — public config only. Never put provider, treasury or hot-wallet keys here.

# Hono API base URL (Heroku testnet or mainnet app)
NEXT_PUBLIC_API_URL=http://localhost:8787

# testnet | mainnet
NEXT_PUBLIC_TEMPO_NETWORK=testnet

# Spend-permission scope (PDF: USDC.e only, SmartRouter as payee)
NEXT_PUBLIC_SMARTROUTER_PAYEE=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDCE_ADDRESS=0x0000000000000000000000000000000000000000

# Tempo SDK origins for CSP connect-src/frame-src (comma separated) — GAP, see Backend_Gaps_Report §8
NEXT_PUBLIC_TEMPO_ORIGINS=

# Object storage host for generated images and songs (hostname only)
NEXT_PUBLIC_OBJECT_STORAGE_HOST=

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=

# Display-only fee hint in basis points (API is authoritative; PDF: 10%)
NEXT_PUBLIC_FEE_BPS=1000

# Feature flags (PDF cut order: Compare first, then music)
NEXT_PUBLIC_FLAG_COMPARE=1
NEXT_PUBLIC_FLAG_MUSIC=1

# Run fully offline against MSW mocks
NEXT_PUBLIC_MOCK=0
